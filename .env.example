# Database (Neon recommended - https://neon.tech)
# Paste your connection string below. If it ends with ?sslmode=require,
# as Neon's does, change that word to verify-full: it is the stricter
# mode, and the other one makes Node print an SSL warning at every start.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
# DIRECT_URL is not read by the kit: with Prisma 7 the app and the migrations
# both come from DATABASE_URL. Some hosts set it for you. See docs/configuration.md.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Better Auth - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""


# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Not read by any code: checkout and the billing portal redirect to pages
# Stripe hosts, which need only the secret key. Was:
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe Price IDs - create in Stripe dashboard → Products, then run the seed
# (npx prisma db seed) so the example plans pick them up. STRIPE_METERED_PRICE_ID
# is only needed for the usage-based example (see docs/billing.md).
STRIPE_STARTER_PRICE_ID=""
STRIPE_STARTER_YEARLY_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""
STRIPE_LIFETIME_PRICE_ID=""
STRIPE_METERED_PRICE_ID=""

# Promotion codes at checkout - OPTIONAL. "true" adds the promotion code field
# to Stripe Checkout; create the codes in the Stripe dashboard under Product
# catalog -> Coupons. Off by default because Checkout shows the field whether or
# not any code exists, and an empty field sends customers looking for a
# discount that is not there. An active discount shows on the billing page.
STRIPE_ALLOW_PROMOTION_CODES=""

# Stripe Tax at checkout - OPTIONAL. "true" turns on automatic tax, a required
# billing address and tax ID (VAT number) collection in Checkout. Activate
# Stripe Tax in the Stripe dashboard first, and add a registration for every
# place you collect tax in. With Tax not active, Checkout still works but
# charges no tax, and the server logs a warning at each checkout until the
# setup is done. Stripe Tax calculates and collects: it registers you nowhere.
STRIPE_AUTOMATIC_TAX=""

# App URL - no trailing slash
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public GitHub repo URL (Free tier "Get it on GitHub" button)
NEXT_PUBLIC_GITHUB_URL=""

# Branding - rebrand the kit from here. All optional; neutral defaults live
# in src/config/site.ts and src/app/globals.css (see docs/configuration.md).
NEXT_PUBLIC_BRAND_NAME=""
NEXT_PUBLIC_BRAND_TAGLINE=""
NEXT_PUBLIC_BRAND_DESCRIPTION=""
# Title for <title> and search results. Unset = "name | tagline". Set it when
# the words people search for differ from the claim you show on the page.
NEXT_PUBLIC_SEO_TITLE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
# Shown in "Who builds it" on the About page; the section hides when unset.
NEXT_PUBLIC_MAINTAINER_NAME=""
NEXT_PUBLIC_MAINTAINER_URL=""
NEXT_PUBLIC_GITHUB_ORG_URL=""
NEXT_PUBLIC_X_URL=""
# LinkedIn company page for the footer icon.
NEXT_PUBLIC_LINKEDIN_URL=""
# More footer social icons. Each icon is shown either way: a link when its
# URL is set, inert (not a link) until then.
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_PINTEREST_URL=""
# Store listings for the mobile apps. Until set, the footer's App Store and
# Google Play badges are inert placeholders marked "coming soon".
NEXT_PUBLIC_APP_STORE_URL=""
NEXT_PUBLIC_PLAY_STORE_URL=""
# Gradient-highlight a substring of the name in the logo (e.g. "Starter").
NEXT_PUBLIC_BRAND_WORDMARK_ACCENT=""
# Accent colors (hex). Unset = neutral black + grayscale. The gradient is
# accent is used solid; set BRAND_GRADIENT for a gradient instead.
NEXT_PUBLIC_BRAND_PRIMARY=""
NEXT_PUBLIC_BRAND_PRIMARY_2=""
NEXT_PUBLIC_BRAND_GRADIENT=""
# Your mark: a square image under public/ (e.g. "/brand/mark.png"). Used for
# the logo, favicon, home-screen icon and email header. Empty = neutral mark.
NEXT_PUBLIC_BRAND_MARK=""

# Demo mode - for a PUBLIC DEMO deployment only (isolated DB, fake data).
# "true" disables the OAuth buttons and enables one-click sign-in to shared
# demo accounts (user + admin). Seed the fake data with: npm run db:seed:demo
# ⚠️ Never enable on a deployment with real users.
DEMO_MODE=""

# Cron secret - vercel.json schedules the e-sign job (expiring links,
# reminders, sealing retries); Vercel sends this value as
# "Authorization: Bearer ...", and the route refuses to run when it is unset.
# Required in production. Generate one with: openssl rand -base64 32
# A demo is reset by hand with: npm run db:seed:demo (there is no scheduled
# reset; it would need an endpoint able to delete every user).
CRON_SECRET=""

# IndexNow - tells Bing, Yandex and the other IndexNow engines when a page is
# published or updated (a daily cron, /api/indexnow). Optional: leave it empty
# and a key is derived from CRON_SECRET. Served at /indexnow-key.txt.
# 8 to 128 letters, digits or dashes; generate one with: openssl rand -hex 16
INDEXNOW_KEY=""

# Live demo URL - when set, "Sign in" and "Demo" on the public pages link
# here instead of the local /login (useful when this deployment is the
# marketing site and the demo runs elsewhere)
NEXT_PUBLIC_DEMO_URL=""

# Kit site - leave this empty. It is only for the deployment that sells the
# kit itself: "true" switches the landing, pricing, FAQ and footer to talk
# about the repository (open source tiers, Pro waitlist, MIT links) instead of
# about your product. Turning it on here gives you our marketing site, not a
# template of one. The mechanism behind it is reusable and the copy is not:
# see "Two deployments from one codebase" in docs/configuration.md.
KIT_SITE=""

# Waitlist gate (kit site only) - the Pro waitlist form on the open source
# pricing ships DISABLED until this is "true", so no deployment can collect
# emails before its real privacy policy is live. Meaningless without KIT_SITE.
WAITLIST_ENABLED=""

# "Built with OpenStarterKit" badge - shown by default in the app footer.
# You're completely free to remove it: set this to "true" (also accepted:
# 1, yes, on, any case). It is read when the app builds, so redeploy after
# changing it. No fee, no unlock.
# If the kit saved you time, a coffee is the nicest thanks (optional):
# https://buymeacoffee.com/openstarterkit
NEXT_PUBLIC_REMOVE_BRANDING=""

# Resend - https://resend.com
# Add your domain in Resend dashboard → Domains, then set EMAIL_FROM
# Powers ALL outgoing email: welcome + subscription emails, magic link
# sign-in and password reset (those two auth flows hide in the UI without it)
RESEND_API_KEY=""
EMAIL_FROM="Acme <hello@yourdomain.com>"

# Rate limiting across instances - OPTIONAL, and the kit works without it.
# Unset, the limits live in each instance's memory: a speed bump on serverless,
# because a request that lands elsewhere starts from zero. Set both and the same
# counters move to Upstash Redis, shared by every instance and region.
# Free tier is generous, and it is two fetch calls: no client library is added.
# https://console.upstash.com -> create a Redis database -> REST API
#
# Worth doing first if what you are protecting is your Resend bill: the sign-in
# limit is backed by bcrypt's cost anyway, the email ones are not backed by
# anything else. See docs/authentication.md.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend Audience for the newsletter waitlist (Resend dashboard → Audiences).
# Optional: without it the database list still works, only the Resend Audience
# mirror is skipped and the signup form stays enabled (see docs/newsletter.md).
RESEND_AUDIENCE_ID=""

# One sentence for the machines that summarise you, served in /llms.txt.
# Optional. Say what you do and who for, in the words someone would use asking
# for it. Left empty, /llms.txt still describes the site from its name,
# description and content.
NEXT_PUBLIC_LLMS_SUMMARY=

# Set to "true" to stop mounting Vercel Analytics. Left empty it stays on,
# which is the useful default when you deploy to Vercel.
NEXT_PUBLIC_DISABLE_ANALYTICS=

# ─── Salsox e-signatures (docs/esign.md) ─────────────────────────────────────
# REQUIRED IN PRODUCTION, all three: BLOB_READ_WRITE_TOKEN (below),
# RESEND_API_KEY with EMAIL_FROM, and CRON_SECRET (both above). The server
# refuses to start in production without them, because each one missing fails
# silently: uploads lost, invitations never sent, scheduled jobs never run.
# Optional in development. A DEMO_MODE deployment is exempt.
#
# Private document storage. Unset: files go to .data/storage (development only).
BLOB_READ_WRITE_TOKEN=""
# Sign & Pay through Paystack (cards + mobile money). Country for the bank list.
PAYSTACK_SECRET_KEY=""
PAYSTACK_COUNTRY="ghana"
# Optional platform fee on Sign & Pay, in basis points (150 = 1.5%).
SIGN_AND_PAY_FEE_BPS=""
# Optional digital seal: base64 PKCS#12 certificate and its passphrase.
SIGNING_P12_BASE64=""
SIGNING_P12_PASSPHRASE=""
# Optional SMS reminders for pending signatures (Twilio, docs/esign.md).
# Senders opt in per document; recipients need a phone number with a country
# code. Leave these as they are and the option never appears: the app checks
# that each value looks real (AC + 32 hex, 32 hex token, +E.164 number) and
# stays off otherwise. Use TWILIO_MESSAGING_SERVICE_SID (MG...) instead of a
# from-number if you send through a Messaging Service.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FROM_NUMBER="+15551234567"
TWILIO_MESSAGING_SERVICE_SID=""
# Set to "false" to switch SMS off without removing the credentials.
SMS_REMINDERS_ENABLED=""

# ─── Search and analytics (docs/seo.md) ──────────────────────────────────────
# All optional. Ownership tokens for Google Search Console and Bing Webmaster
# Tools (the content of their HTML meta tag). Leave empty if you verify by DNS.
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Unset: GA never loads and
# the Content-Security-Policy names no Google host. Set: GA runs in Consent
# Mode behind a consent banner (src/lib/analytics-consent.ts). Turn off
# "Page changes based on browser history events" in the GA stream's enhanced
# measurement, or client-side navigations count twice (docs/seo.md).
# Was: "Check whether your visitors' countries require a consent banner
# before you set it." The banner is now built in.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Read access for the admin Traffic page (/admin/analytics/traffic). Both
# optional and server only. The property's number (GA Admin → Property
# details; not the G- id), and a Google Cloud service account's JSON key,
# base64-encoded (`base64 -w0 key.json`), with the Google Analytics Data API
# enabled and the account added as a Viewer on the property.
GA4_PROPERTY_ID=""
GA_SERVICE_ACCOUNT_KEY_BASE64=""
# SEO agent - OPTIONAL (src/lib/seo-agent, docs/seo.md "SEO agent"). A daily
# cron that writes one blog article for a Search Console query the site shows
# up for but gets no clicks on. Reads Search Console with the service account
# above: add that account to the Search Console property as a user. Needs an
# Anthropic API key to write; without one the daily run is skipped.
ANTHROPIC_API_KEY=""
# The Search Console property, when it is not NEXT_PUBLIC_APP_URL with a
# trailing slash (a domain property is "sc-domain:example.com").
SEARCH_CONSOLE_SITE_URL=""
# Optional overrides: the writing model (default claude-opus-5-5) and the
# fewest 90-day impressions a query needs to be considered (default 50).
SEO_AGENT_MODEL=""
SEO_AGENT_MIN_IMPRESSIONS=""
# Outreach agent - OPTIONAL (src/lib/outreach-agent, admin tab Analytics >
# Outreach agent). Finds public complaints about other e-signature tools,
# writes to the people behind them once an admin adds their address, follows
# up once, labels replies, and drafts social posts. Uses ANTHROPIC_API_KEY
# (above) and RESEND_API_KEY. Nothing is sent until all of these are set:
# The sender, on a SEPARATE domain from EMAIL_FROM (a new subdomain verified in
# Resend), so outreach can never hurt the deliverability of product email.
OUTREACH_EMAIL_FROM=
# Where replies go (an inbound address on the same subdomain); the sender if empty.
OUTREACH_REPLY_TO=
# The first name the emails are signed with, and an optional role.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_ROLE=
# Your postal address, printed in every email's footer (CAN-SPAM, UK/EU rules).
OUTREACH_POSTAL_ADDRESS=
# Replies: point Resend's inbound email for the subdomain at a webhook on
# /api/webhooks/outreach-inbound for the email.received event, and paste its
# signing secret here. Without it, replies can still be pasted in by hand.
OUTREACH_INBOUND_WEBHOOK_SECRET=
# Unsubscribe links are signed with a key derived from CRON_SECRET; set this
# only to use a different one.
OUTREACH_UNSUBSCRIBE_SECRET=
# Lead sources. A self-hosted Crawl4AI server (docs.crawl4ai.com, Docker) for
# G2, Capterra and Trustpilot reviews; pages a site's robots.txt disallows are
# skipped. Reddit through its official API (an app at reddit.com/prefs/apps).
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Social posting, each platform only through its official API; a platform is
# offered once its credentials are set. Facebook Page (Meta Graph API):
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=
# LinkedIn company page (Posts API, w_organization_social):
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_API_VERSION=
# X (API v2, OAuth 2.0 user token with tweet.write):
X_ACCESS_TOKEN=
# Optional: the "sent via" line for a standalone release names this tool (the
# line stays off until it is switched on in the admin tab), and model overrides
# (defaults claude-opus-5-5 for writing, claude-haiku-5-5 for reading).
OUTREACH_TOOL_NAME=
OUTREACH_TOOL_URL=
OUTREACH_AGENT_MODEL=
OUTREACH_AGENT_FAST_MODEL=
# PostHog product analytics - OPTIONAL (src/lib/posthog-config.ts). The
# project API key (phc_..., Project settings in PostHog) turns it on. It runs
# cookieless: no cookie or browser storage, nobody identified, so no consent
# banner is needed for it. ALSO switch on cookieless mode in the PostHog
# project's settings, or PostHog drops every event. Host: https://us.i.posthog.com
# (the default) or https://eu.i.posthog.com, matching your project's region.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ─── Error tracking: Sentry (docs/configuration.md) ──────────────────────────
# All optional. The DSN from your Sentry project's settings (Client Keys).
# Unset: Sentry stays off and the Content-Security-Policy names no Sentry host.
# Signing tokens are scrubbed from every report (src/lib/sentry.ts).
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only, for readable stack traces: uploads source maps, then deletes
# them from the build output. An organization auth token (Settings > Auth
# Tokens) and the organization and project slugs from the project's URL.
# Without all three the upload is skipped and errors are still reported.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
