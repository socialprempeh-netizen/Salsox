generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum BillingInterval {
  MONTH
  YEAR
  // One-time purchase (e.g. a lifetime deal): checkout runs in "payment" mode
  // and the grant is recorded as a Purchase instead of a Subscription.
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
  INCOMPLETE
}

enum PurchaseStatus {
  COMPLETED
  REFUNDED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                    String          @id @default(cuid())
  // Required by Better Auth, where Auth.js left it optional. The 2.0 migration
  // backfills the users that had none: OAuth fills it from the provider profile
  // afterwards, but the column cannot be null in the meantime.
  name                  String
  email                 String          @unique
  // A boolean here, a timestamp in Auth.js. The 2.0 migration turns "has a
  // date" into true and null into false, and the exact moment is not
  // recoverable afterwards. Nothing in the kit read it as a date.
  emailVerified         Boolean         @default(false)
  image                 String?
  role                  Role            @default(USER)
  // Owned by the two-factor plugin, which is why it is `input: false` on its
  // side: nobody can set it through the API or an OAuth profile. It exists on
  // User rather than being derived from the TwoFactor row because sign-in has
  // to know whether to stop and ask, before it goes looking for a secret.
  twoFactorEnabled      Boolean         @default(false)
  // When the user dismissed the one-time suggestion to turn on 2FA, shown to
  // people with a payout account (src/lib/two-factor-policy.ts). Kept on the
  // account, not in the browser, so "once" means once, on every device.
  twoFactorNudgeDismissedAt DateTime?
  stripeCustomerId      String?         @unique
  // When the user dismissed the "Get started" checklist; the checklist items
  // themselves are derived live (name, documents, billing), only this persists.
  onboardingDismissedAt DateTime?
  // Where the account came from: the first public page the visitor landed on,
  // the referring host and utm tags, recorded from the first-party sx_src
  // cookie at signup (src/lib/seo/attribution.ts). `signupChannel` is the
  // classification (organic_search, social, ...), kept as a column so the
  // admin SEO page can count signups per channel without scanning JSON.
  acquisition           Json?
  signupChannel         String?
  // Peer referrals (src/lib/referrals.ts). `referralCode` is the user's own
  // invite code, made the first time they open the referrals page;
  // `referredById` is who invited them, recorded at signup from the sx_ref
  // cookie. `referralProUntil` is when the free Pro months earned by inviting
  // people end: the plan rules read it next to billing (accountTier in
  // src/lib/esign/sender.ts).
  referralCode          String?         @unique
  referredById          String?
  referredBy            User?           @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             User[]          @relation("Referrals")
  referralProUntil      DateTime?
  referralRewards       ReferralReward[] @relation("RewardEarner")
  referralRewardFor     ReferralReward?  @relation("RewardReferee")
  // Affiliate program (src/lib/affiliates.ts): the affiliate whose link this
  // account signed up through (sx_aff cookie), and the user's own affiliate
  // profile when they have joined.
  affiliateId           String?
  referredByAffiliate   Affiliate?      @relation("AffiliateSignups", fields: [affiliateId], references: [id], onDelete: SetNull)
  affiliate             Affiliate?      @relation("AffiliateOwner")
  affiliateCommissions  AffiliateCommission[]
  accounts              Account[]
  sessions              Session[]
  twoFactor             TwoFactor[]
  subscription          Subscription?
  purchases             Purchase[]
  documents             Document[]
  payoutAccounts        PayoutAccount[]
  savedTemplates        SavedTemplate[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([signupChannel, createdAt])
  @@index([referredById])
  @@index([affiliateId, createdAt])
}

// Affiliate program (src/lib/affiliates.ts). An affiliate is a user who has
// joined with a code of their choosing; links are /go/{code}. Commission is
// recorded per payment in AffiliateCommission; payouts are settled by hand.
model Affiliate {
  id        String           @id @default(cuid())
  userId    String           @unique
  code      String           @unique
  // An admin can pause an affiliate: links still redirect, nothing is
  // recorded for them.
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  user      User             @relation("AffiliateOwner", fields: [userId], references: [id], onDelete: Cascade)
  signups   User[]           @relation("AffiliateSignups")
  clicks      AffiliateClick[]
  commissions AffiliateCommission[]
}

// One row per visit through an affiliate link. No address, no user agent,
// no cookie value: only when, where to, the referring host, and whether this
// browser had arrived through the same link before (`unique` is false then).
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  path        String
  refHost     String?
  unique      Boolean
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
}

// One row per payment a referred customer made inside their commission
// window (AFFILIATE_COMMISSION in src/lib/affiliates.ts), written by the
// Stripe webhook. `sourceId` is the Stripe invoice or PaymentIntent id and is
// unique, so a replayed event can never record the same payment twice.
// `percent` keeps the rate the row was earned at, so changing the terms
// later does not rewrite history. A full refund sets `reversedAt`; a payout
// made by hand sets `paidOutAt`. The customer is kept as a nullable link: a
// commission already earned stays owed if they delete their account.
model AffiliateCommission {
  id              String    @id @default(cuid())
  affiliateId     String
  customerId      String?
  sourceId        String    @unique
  paymentIntentId String?
  amount          Int
  commission      Int
  currency        String
  percent         Int
  paidAt          DateTime
  reversedAt      DateTime?
  paidOutAt       DateTime?
  createdAt       DateTime  @default(now())
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  customer        User?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([affiliateId, paidAt])
  @@index([customerId, paidAt])
  @@index([paymentIntentId])
}

// One reward per invited person, granted when they become active (send their
// first document). `refereeId` is unique, so a second send, a retry or a race
// between two sends can never pay the same invitation twice.
model ReferralReward {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String   @unique
  months     Int
  // The referrer's referralProUntil after this reward, kept for the history.
  proUntil   DateTime
  createdAt  DateTime @default(now())
  referrer   User     @relation("RewardEarner", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User     @relation("RewardReferee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

// One row per way of signing in. OAuth accounts and the email+password
// credential both live here, and the password hash is a column on THIS table,
// not on User: it is the single most consequential difference from Auth.js, and
// the one a migration can get wrong without any error appearing.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  // The identifier the provider gave us. Paired with providerId it identifies
  // the account at sign-in: Better Auth 1.7.0 through 1.7.2 keyed accounts by
  // an issuer column instead, and 1.7.3 reverted that. See the 2.1.0 migration.
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  // Was `expires_at`, an integer of unix seconds. This is a timestamp: the 2.0
  // migration CONVERTS it, it does not rename it. Renaming it would leave every
  // OAuth token in the table looking like it expired in 1970.
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  // The bcrypt hash that used to live in User.passwordHash.
  password              String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// Sessions are rows now, not signed cookies. That is what makes revoking one
// possible: deleting the row ends it everywhere, immediately, which is what the
// sessionVersion column on User used to fake.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  // When this session passed a second factor: the sign-in code, a backup
  // code, finishing 2FA setup, or the admin check at /dashboard/admin-verify.
  // Ours, not Better Auth's (it never reads it). Admins need it set to use
  // the admin area (src/lib/two-factor-policy.ts), which is what makes 2FA
  // required at login for them even when they arrive through Google.
  twoFactorVerifiedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per user who turned on two-factor authentication, added in 2.2.
//
// Every column here is Better Auth's, not ours: the plugin declares this shape
// and reads it by these names. The three that are easy to miss are the ones
// that make it safe. `verified` stays false between "enable" and the first
// correct code, so an interrupted setup never locks anyone out. The other two
// are the plugin's own lockout: ten consecutive wrong codes park the account
// until `lockedUntil`, which is what stops a six-digit code from being guessed
// at leisure.
//
// `secret` and `backupCodes` are written encrypted (storeBackupCodes in
// src/auth.ts); the plugin never returns either one to the client.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@index([secret])
}

// Every short-lived token Better Auth issues: magic links, email verification
// and password resets all land here. It replaces both VerificationToken and the
// hand-rolled PasswordResetToken table, so two things become one.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Plan {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  price          Int
  interval       BillingInterval
  stripePriceId  String          @unique
  // Set only on metered (usage-based) plans: the Stripe Billing Meter event
  // name that recordUsage() reports against. Metered prices must be checked
  // out without a quantity.
  meterEventName String?
  // Days of free trial on this plan, offered only to a customer who has never
  // had a subscription (trialDaysFor in src/lib/billing.ts). Null is no trial.
  // Stripe accepts up to 730.
  trialDays      Int?
  features       String[]
  isActive       Boolean         @default(true)
  subscriptions  Subscription[]
  purchases      Purchase[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  planId               String
  stripeSubscriptionId String             @unique
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  // Written from Stripe when the subscription started with a trial, and still
  // set after the trial is over: read it together with the status, which says
  // TRIALING only while the trial runs.
  trialEndsAt          DateTime?
  // Salsox never renews silently: the e-sign cron emails a notice ahead of
  // every renewal and stamps this with the period it was sent for, so a
  // notice goes out once per period and a renewed period gets its own.
  renewalNoticeSentAt  DateTime?
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan               @relation(fields: [planId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

// One-time payments (ONE_TIME plans). The PaymentIntent id is the idempotency
// key for the webhook: replays find the existing row and no-op. userId is not
// unique on purpose — a real product may sell several one-time items.
model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  planId                  String
  stripePaymentIntentId   String         @unique
  stripeCheckoutSessionId String?        @unique
  amount                  Int
  currency                String         @default("usd")
  status                  PurchaseStatus @default(COMPLETED)
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                    Plan           @relation(fields: [planId], references: [id])
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([userId])
}

// ─── Newsletter / pre-launch waitlist ─────────────────────────────────────────
// Double opt-in mailing list, owned in your database (docs/newsletter.md).
// createdAt records the latest signup request and confirmedAt the completed
// opt-in: together they are the proof of consent. Tokens are random DB values,
// so a link can be revoked by rotating the token — no extra secrets involved.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  source           String    @default("waitlist") // where the signup came from, e.g. "pricing-card"
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  confirmToken     String    @unique
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
}

// ─── E-signature (Salsox) ─────────────────────────────────────────────────────
// A clean-room design informed by how open e-signature engines model the
// problem (a document, its recipients, the fields each recipient fills, and an
// append-only audit trail). No code was copied from any AGPL project.
//
// Deliberate differences from DocuSign-style products:
// - No envelope counters anywhere: nothing here limits how many documents a
//   plan may send (see docs/esign.md).
// - A recipient's email can be corrected, or their expired link renewed, in
//   place: fields and other signatures stay attached to the recipient row, and
//   only the token rotates.

enum DocumentStatus {
  DRAFT
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SigningOrder {
  PARALLEL
  SEQUENTIAL
}

enum RecipientRole {
  SIGNER
  APPROVER
  VIEWER
  CC
}

enum SigningStatus {
  NOT_SIGNED
  SIGNED
  REJECTED
}

enum FieldType {
  SIGNATURE
  INITIALS
  NAME
  EMAIL
  DATE
  TEXT
  CHECKBOX
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Document {
  id              String           @id @default(cuid())
  userId          String
  title           String
  status          DocumentStatus   @default(DRAFT)
  // Storage keys, resolved by src/lib/esign/storage.ts. The original is never
  // modified; the sealed copy is written once, when the last signer finishes.
  originalKey     String
  originalSha256  String
  sealedKey       String?
  sealedSha256    String?
  pageCount       Int
  signingOrder    SigningOrder     @default(PARALLEL)
  subject         String?
  message         String?
  // Days each recipient link stays valid after it is (re)issued. Null: never.
  expiresInDays   Int?
  // Created from the one-screen Quick Send flow (fields placed automatically).
  quickSend       Boolean          @default(false)
  // Sent from a request prepared on the public request-a-signature tool
  // (/request-signature). Free accounts get one such send in their lifetime
  // (FREE_REQUEST_TOOL_USES in src/lib/esign/plans.ts), counted from this.
  fromRequestTool Boolean          @default(false)
  // Sign & Pay. Amount is in the currency's minor unit (cents, pesewas, kobo).
  // Null amount means the document collects no payment.
  paymentAmount   Int?
  paymentCurrency String?
  paymentProvider PaymentProvider?
  // Printed on the certificate page of the sealed copy and looked up by the
  // public /verify page (src/lib/esign/verify.ts). Set once, in the same
  // commit that stores the sealed copy; null on anything not completed, and
  // on documents completed before codes existed (those verify by their id).
  verificationCode String?        @unique
  // Sender opted in to SMS reminders for recipients with a phone number, on
  // top of the email ones (src/lib/esign/sms.ts). Ignored when the deployment
  // has no SMS provider configured.
  smsReminders    Boolean          @default(false)
  sentAt          DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipients      Recipient[]
  fields          Field[]
  auditEvents     AuditEvent[]
  payments        Payment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, status])
}

model Recipient {
  id              String        @id @default(cuid())
  documentId      String
  email           String
  name            String
  phone           String?
  role            RecipientRole @default(SIGNER)
  // Position in a SEQUENTIAL document; ignored for PARALLEL ones.
  order           Int           @default(0)
  // The secret in the signing link. Rotated whenever the email is corrected or
  // the link renewed, so a link sent to a wrong address stops working.
  token           String        @unique
  tokenIssuedAt   DateTime      @default(now())
  expiresAt       DateTime?
  // With Sign & Pay, the one recipient who pays before completing.
  mustPay         Boolean       @default(false)
  signingStatus   SigningStatus @default(NOT_SIGNED)
  sentAt          DateTime?
  viewedAt        DateTime?
  signedAt        DateTime?
  rejectionReason String?
  lastReminderAt  DateTime?
  document        Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fields          Field[]
  signatures      Signature[]
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([documentId])
}

// Positions are percentages of the page (0-100), measured from the top-left
// corner, so a field lands in the same place whatever size the page renders at.
model Field {
  id          String     @id @default(cuid())
  documentId  String
  recipientId String
  type        FieldType
  page        Int // 1-based
  x           Float
  y           Float
  width       Float
  height      Float
  required    Boolean    @default(true)
  label       String?
  // Text, date or "true"/"false" for checkboxes. Signatures live in Signature.
  value       String?
  inserted    Boolean    @default(false)
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipient   Recipient  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  signature   Signature?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([documentId])
  @@index([recipientId])
}

model Signature {
  id           String    @id @default(cuid())
  fieldId      String    @unique
  recipientId  String
  // A PNG data URL (drawn or uploaded) or typed text rendered at seal time.
  imageDataUrl String?
  typedText    String?
  field        Field     @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recipient    Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
}

// Sign & Pay collections. providerRef (Stripe Checkout Session id or Paystack
// reference) is the webhook idempotency key.
model Payment {
  id          String          @id @default(cuid())
  documentId  String
  recipientId String
  provider    PaymentProvider
  providerRef String          @unique
  amount      Int
  currency    String
  status      PaymentStatus   @default(PENDING)
  paidAt      DateTime?
  document    Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  recipient   Recipient       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([documentId])
}

// Append-only. Rendered onto the certificate page of the sealed PDF, so every
// row is evidence: never update or delete one outside account deletion.
model AuditEvent {
  id          String   @id @default(cuid())
  documentId  String
  recipientId String?
  type        String
  data        Json?
  actorEmail  String?
  ipAddress   String?
  userAgent   String?
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([documentId, createdAt])
}

// Where a sender's Sign & Pay money goes: a Stripe Connect account id
// (acct_...) or a Paystack subaccount code (ACCT_...).
model PayoutAccount {
  id                String          @id @default(cuid())
  userId            String
  provider          PaymentProvider
  externalAccountId String
  ready             Boolean         @default(false)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([userId, provider])
}

// ─── Founder outreach (admin only) ────────────────────────────────────────────
// The manual conversations the founder is having with prospects (LinkedIn,
// email, Reddit), tracked at /admin/outreach so none of them gets lost. Not
// tied to a User: these people do not have accounts, and most never will.
// One shared list for every admin, deliberately: it is a working sheet, not
// a CRM.
enum OutreachChannel {
  LINKEDIN
  EMAIL
  REDDIT
}

enum OutreachStatus {
  NO_REPLY
  REPLIED
  CONVERTED
}

model OutreachContact {
  id          String          @id @default(cuid())
  name        String
  company     String?
  channel     OutreachChannel
  // A day, not a moment: stored at midnight UTC and shown without a time.
  contactedAt DateTime        @db.Date
  status      OutreachStatus  @default(NO_REPLY)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([contactedAt])
}

// ─── Saved templates ──────────────────────────────────────────────────────────
// A customised copy of a library template (content/templates, src/lib/
// templates.ts), saved to reuse: which template, a name, and the values typed
// into its blanks. The document text itself stays in the library, so a fix to
// a template reaches every saved copy. A Personal-plan feature
// (savedTemplates in src/lib/esign/plans.ts).
model SavedTemplate {
  id           String   @id @default(cuid())
  userId       String
  templateSlug String
  name         String
  values       Json
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ─── IndexNow ───────────────────────────────────────────────────────────────
// What this site has told search engines, so submission is not a black box
// (src/lib/indexnow-store.ts, shown on /admin/seo/inventory).

// One request to api.indexnow.org: why it was sent, which URLs (the first 50;
// `urlCount` has the total) and what the endpoint answered. `status` is 0
// when no answer came back at all (network error, timeout).
model IndexNowPing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // deploy (first request a new production deployment served), cron (the
  // daily safety net) or manual (a POST to /api/indexnow).
  trigger   String
  urlCount  Int
  urls      String[]
  status    Int
  ok        Boolean
  error     String?

  @@index([createdAt])
}

// The last version of each URL that was accepted: a URL is submitted again
// only when its sitemap lastModified moves past this (or it is new).
model IndexNowUrl {
  url          String    @id
  lastModified DateTime?
  submittedAt  DateTime
}

// One row per production deployment that has run its deploy-time sync, so
// several instances starting at once submit once between them.
model IndexNowDeploy {
  id        String   @id
  createdAt DateTime @default(now())
}

// ─── SEO agent ───────────────────────────────────────────────────────────────
// The daily content agent (src/lib/seo-agent): which search queries it chose
// to write for, the articles it wrote, the links it added to other pages, its
// run log, the orphan pages its weekly crawl found and its one setting.
// Tables are snake_case, unlike the rest of the schema, because the module is
// kept self-contained enough to move to a product of its own.

// Where a target stands. The target carries the one status for its article
// too, so the two cannot disagree.
enum SeoAgentTargetStatus {
  WRITING
  DRAFT
  PUBLISHED
  DISCARDED
  FAILED
}

// A query picked from Search Console. `keyword` is unique: once a phrase has
// been chosen it is never chosen again, whatever became of its article.
model SeoAgentTarget {
  id            String               @id @default(cuid())
  keyword       String               @unique
  status        SeoAgentTargetStatus @default(WRITING)
  publishedSlug String?              @map("published_slug")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  // What Search Console showed when it was picked (90 days, all pages).
  impressions   Int
  clicks        Int
  position      Float
  score         Float
  // The page that already ranked for it, if any.
  page          String?
  error         String?
  // A FAILED target is tried once more on a later run (a timeout should not
  // cost the best query for good), then left alone.
  attempts      Int                  @default(1)
  article       SeoAgentArticle?

  @@index([status])
  @@map("seo_agent_targets")
}

// The article written for a target: Markdown body without its FAQ section,
// which is rendered from `faq` so the visible answers and the FAQPage schema
// come from one value.
model SeoAgentArticle {
  id           String           @id @default(cuid())
  targetId     String           @unique @map("target_id")
  target       SeoAgentTarget   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  slug         String           @unique
  title        String
  description  String
  category     String
  keyword      String
  body         String
  faq          Json
  related      String[]
  model        String
  // Published without review, under the auto-publish rule.
  autoPublished Boolean         @default(false) @map("auto_published")
  publishedAt  DateTime?        @map("published_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  links        SeoAgentLink[]

  @@map("seo_agent_articles")
}

// One contextual link to an article, added to another page at render time
// (the page's own file is never edited): after which paragraph, and the
// sentence carrying the link.
model SeoAgentLink {
  id             String          @id @default(cuid())
  articleId      String          @map("article_id")
  article        SeoAgentArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  sourcePath     String          @map("source_path")
  afterParagraph Int             @map("after_paragraph")
  sentence       String
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([articleId, sourcePath])
  @@index([sourcePath])
  @@map("seo_agent_links")
}

// One run of the agent: the daily article run or the weekly orphan crawl.
model SeoAgentRun {
  id         String    @id @default(cuid())
  // daily | orphans
  kind       String
  // cron | manual
  trigger    String
  // running | ok | skipped | failed
  status     String
  message    String?
  candidates Int       @default(0)
  targetId   String?   @map("target_id")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([kind, startedAt])
  @@map("seo_agent_runs")
}

// A page the weekly crawl found with no internal link pointing to it, kept
// for a person to look at. Nothing is edited automatically.
model SeoAgentOrphan {
  path        String   @id
  // OPEN | REVIEWED
  status      String   @default("OPEN")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")

  @@map("seo_agent_orphans")
}

// The agent's one setting, a single row (id 1). `draftFirst` forces review of
// every article; off, articles after the first three publish themselves.
model SeoAgentSettings {
  id         Int      @id @default(1)
  draftFirst Boolean  @default(false) @map("draft_first")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("seo_agent_settings")
}

// What the SEO agent writes since it stopped writing blog articles from
// Search Console gaps (src/lib/seo-agent/page-agent.ts): template pages,
// comparison and alternative pages, and e-signature law pages. `data` is the
// page's full frontmatter, re-validated with the same schema as the file
// pages whenever it is read; `report` is what each quality gate found.
enum SeoAgentPageKind {
  TEMPLATE
  COMPARISON
  ALTERNATIVE
  COMPLIANCE
}

// FLAGGED: too close to an existing page. Never published automatically; if
// a person publishes it anyway it goes live noindexed, outside the sitemap.
enum SeoAgentPageStatus {
  DRAFT
  FLAGGED
  PUBLISHED
  DISCARDED
  FAILED
}

model SeoAgentPage {
  id            String             @id @default(cuid())
  kind          SeoAgentPageKind
  slug          String
  status        SeoAgentPageStatus @default(DRAFT)
  title         String             @default("")
  data          Json?
  body          String             @default("")
  report        Json?
  // Highest body similarity to an existing page (0-1), and which page.
  similarity    Float              @default(0)
  similarTo     String?            @map("similar_to")
  noindex       Boolean            @default(false)
  model         String?
  error         String?
  // A FAILED page is tried once more on a later run, then left alone.
  attempts      Int                @default(1)
  autoPublished Boolean            @default(false) @map("auto_published")
  publishedAt   DateTime?          @map("published_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@unique([kind, slug])
  @@index([status])
  @@map("seo_agent_pages")
}

// ─── Outreach agent ──────────────────────────────────────────────────────────
// The lead-gen, cold outreach and social agent (src/lib/outreach-agent):
// leads found from public complaints about other e-signature tools, the
// emails written to them and their follow-ups, the replies that came back,
// addresses that asked not to be contacted, social posts, the run log and its
// settings. Tables are snake_case, like the SEO agent's, because both modules
// are kept self-contained enough to move into one product of their own.

// Where a lead stands. NEEDS_CONTACT until an admin adds an address: review
// sites and Reddit do not publish one, and the agent never guesses.
enum OutreachLeadStatus {
  NEEDS_CONTACT
  READY
  CONTACTED
  REPLIED
  SKIPPED
  UNSUBSCRIBED
}

enum OutreachMessageKind {
  INITIAL
  FOLLOW_UP
}

enum OutreachMessageStatus {
  DRAFT
  SENT
  DISCARDED
  FAILED
}

// Leo's reading of a reply.
enum OutreachReplyCategory {
  INTERESTED
  QUESTION
  NOT_NOW
  NOT_INTERESTED
  UNSUBSCRIBE
  OUT_OF_OFFICE
  OTHER
}

// FACEBOOK, LINKEDIN and X publish through their APIs. REDDIT, TIKTOK and
// YOUTUBE are drafted only: Reddit is posted by hand from reddit.com's own
// submit page, and TikTok and YouTube need a video, so their caption, title
// and description are copied in by hand.
enum SocialPlatform {
  FACEBOOK
  LINKEDIN
  X
  REDDIT
  TIKTOK
  YOUTUBE
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  DISCARDED
}

// A public complaint that names a competitor. `sourceKey` (source plus the
// review or thread id, or a hash of the quote) is unique, so the same
// complaint is never stored or contacted twice.
model OutreachLead {
  id               String             @id @default(cuid())
  sourceKey        String             @unique @map("source_key")
  source           String
  competitor       String
  sourceUrl        String             @map("source_url")
  rating           Int?
  quote            String
  complaint        String
  reviewerName     String?            @map("reviewer_name")
  reviewerRole     String?            @map("reviewer_role")
  company          String?
  email            String?
  status           OutreachLeadStatus @default(NEEDS_CONTACT)
  // The Outreach tracker row made by "Add to Customers"; never a user account.
  trackerContactId String?            @map("tracker_contact_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  messages         OutreachMessage[]
  replies          OutreachReply[]

  @@index([status])
  @@index([email])
  @@map("outreach_leads")
}

// An email Marco (INITIAL) or Oscar (FOLLOW_UP) wrote. `fixId` names the
// catalogue entry it was allowed to describe (src/lib/outreach-agent/fixes.ts).
model OutreachMessage {
  id         String                @id @default(cuid())
  leadId     String                @map("lead_id")
  lead       OutreachLead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind       OutreachMessageKind
  status     OutreachMessageStatus @default(DRAFT)
  subject    String
  body       String
  fixId      String                @map("fix_id")
  model      String
  autoSent   Boolean               @default(false) @map("auto_sent")
  providerId String?               @map("provider_id")
  error      String?
  sentAt     DateTime?             @map("sent_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  @@index([leadId, kind])
  @@index([status, sentAt])
  @@map("outreach_messages")
}

// A reply, from the inbound webhook or pasted in by an admin, with Leo's label.
model OutreachReply {
  id         String                @id @default(cuid())
  leadId     String                @map("lead_id")
  lead       OutreachLead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromEmail  String                @map("from_email")
  subject    String
  text       String
  category   OutreachReplyCategory
  summary    String
  // The provider's id for an inbound email, so a redelivered webhook is ignored.
  providerId String?               @unique @map("provider_id")
  source     String
  receivedAt DateTime              @default(now()) @map("received_at")

  @@index([leadId])
  @@map("outreach_replies")
}

// Addresses that unsubscribed or asked not to be contacted: checked before
// every send, whatever the lead's status says. Stored lowercased.
model OutreachSuppression {
  email     String   @id
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("outreach_suppressions")
}

// A post for one of the product's own social accounts, published only through
// that platform's official API.
model SocialPost {
  id           String           @id @default(cuid())
  platform     SocialPlatform
  // The post text; Reddit's post body; TikTok's and YouTube's caption.
  body         String
  // Reddit, TikTok and YouTube only: the post or video title.
  title        String?
  // TikTok and YouTube only: the video description.
  description  String?
  // The idea the batch was drafted from, and the batch: one draft per
  // platform from the same idea share a batchId.
  idea         String?
  batchId      String?          @map("batch_id")
  status       SocialPostStatus @default(DRAFT)
  scheduledFor DateTime?        @map("scheduled_for")
  publishedAt  DateTime?        @map("published_at")
  externalId   String?          @map("external_id")
  error        String?
  model        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([batchId])
  @@map("outreach_social_posts")
}

model OutreachAgentRun {
  id         String    @id @default(cuid())
  kind       String
  trigger    String
  status     String
  message    String?
  count      Int       @default(0)
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([kind, startedAt])
  @@map("outreach_agent_runs")
}

// One row (id 1). `reviewEvery` puts every email back behind approval after
// the first batch; `signature` is the "sent via" line for a standalone
// release, off by default.
model OutreachAgentSettings {
  id          Int      @id @default(1)
  reviewEvery Boolean  @default(false) @map("review_every")
  paused      Boolean  @default(false)
  dailyCap    Int      @default(20) @map("daily_cap")
  signature   Boolean  @default(false)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("outreach_agent_settings")
}
